FROM node:22-bookworm-slim AS dashboard_builder

WORKDIR /opt/hermes
COPY web/package.json web/package-lock.json web/
RUN cd web \
 && npm ci --prefer-offline --no-audit
COPY web web
RUN mkdir -p hermes_cli \
 && cd web \
 && npm run build \
 && npm cache clean --force

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HERMES_HOME=/state/data

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    cryptsetup-bin \
    curl \
    dmsetup \
    e2fsprogs \
    git \
    ripgrep \
    tini \
    util-linux \
 && rm -rf /var/lib/apt/lists/*

COPY . /opt/hermes
WORKDIR /opt/hermes

# `homeassistant` supplies aiohttp for the internal gateway API. `web`
# supplies FastAPI/uvicorn for the public dashboard.
RUN pip install --no-cache-dir ".[homeassistant,web]"

COPY --from=dashboard_builder /opt/hermes/hermes_cli/web_dist /opt/hermes/hermes_cli/web_dist

ENV HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist

RUN chmod +x /opt/hermes/docker/entrypoint.sh \
 && chmod +x /opt/hermes/docker/entrypoint-enclava.sh \
 && chmod +x /opt/hermes/docker/entrypoint-enclava-api.sh \
 && install -m 0755 /opt/hermes/docker/enclava-wait-exec /usr/local/bin/enclava-wait-exec \
 && mkdir -p /state/data \
 && chmod 1777 /state/data

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:${HERMES_DASHBOARD_PORT:-8000}/health || exit 1

VOLUME ["/state/data"]
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/opt/hermes/docker/entrypoint-enclava.sh"]
